{
  "name": "dev_python_ai_node",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "dev_python_ai_node",
  "workspaceFolder": "/workspaces",
  "remoteUser": "node",


  "containerEnv": {
    "HISTFILE": "/commandhistory/.bash_history",
    "PROMPT_COMMAND": "history -a",
    "HISTSIZE": "10000",
    "HISTFILESIZE": "20000"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "afractal.node-essentials",
        "be5invis.vscode-icontheme-nomo-dark",
        "bengreenier.vscode-node-readme",
        "christian-kohler.npm-intellisense",
        "christian-kohler.path-intellisense",
        "dbaeumer.vscode-eslint",
        "docker.docker",
        "donjayamanne.githistory",
        "dotjoshjohnson.xml",
        "eamodio.gitlens",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "idered.npm",
        "inferrinizzard.prettier-sql-vscode",
        "jasonnutter.search-node-modules",
        "leizongmin.node-module-intellisense",
        "mikestead.dotenv",
        "miramac.vscode-exec-node",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-vscode.js-debug-nightly",
        "ms-vsliveshare.vsliveshare",
        "orta.vscode-jest",
        "pflannery.vscode-versionlens",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "swellaby.node-pack",
        "visualstudioexptteam.intellicode-api-usage-examples",
        "visualstudioexptteam.vscodeintellicode",
        "wix.vscode-import-cost",
        "xabikos.javascriptsnippets",
        "yzhang.markdown-all-in-one",
        "zainchen.json",
        "ms-ossdata.vscode-postgresql",
        "qwtel.redis-viewer",
        "humao.rest-client",
        "cweijan.vscode-database-client2",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.isort",
        "ms-python.flake8",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "littlefoxteam.vscode-python-test-adapter"
      ]
    }
  },

//  "postCreateCommand": "mkdir -p /commandhistory && touch /commandhistory/.bash_history && chown node:node /commandhistory/.bash_history",
//"postCreateCommand": "mkdir -p /workspaces/vectorstore /commandhistory && playwright install",
//"postStartCommand": "mkdir -p /commandhistory && touch /commandhistory/.zsh_history && sudo chown -R node:node /home/node/.config /home/node/.cache /home/node/.local /home/node/.npm /home/node/.npm-global /home/node/.ssh /home/node/.codex /home/node/.claude /home/node/.openai /home/node/.anthropic /home/node/.cursor /commandhistory || true",
  
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  }
}